# API gateway
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info
WORKSPACE_AUTH_REQUIRED=true
GOOGLE_OAUTH_CLIENT_ID=replace-with-internal-web-client.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=8090.inc
QUOTA_IDENTITY_HMAC_KEY=replace-with-at-least-32-random-bytes
USER_DAILY_RUN_LIMIT=3
USER_MONTHLY_RUN_LIMIT=10
GLOBAL_DAILY_RUN_LIMIT=50
GLOBAL_CONCURRENT_RUN_LIMIT=2
QUOTA_LEASE_MS=720000
QUOTA_TTL_MS=7776000000
ACCESS_RATE_LIMIT_MAX=60
ACCESS_RATE_LIMIT_WINDOW_MS=60000
EVALUATE_RATE_LIMIT_MAX=20
EVALUATE_RATE_LIMIT_WINDOW_MS=600000
# Trusted reverse-proxy hops for client-IP rate limiting: 0 locally, 2 on App Engine.
TRUST_PROXY_HOPS=0
# Transitional anonymous ceiling used only while WORKSPACE_AUTH_REQUIRED=false.
DAILY_RUN_LIMIT=100
EVALUATIONS_ENABLED=true
EVALUATION_TIMEOUT_MS=150000
PRD_JUDGE_RUNTIME_URL=http://127.0.0.1:8092
USE_GOOGLE_IDENTITY_TOKEN=false
# INTERNAL_SERVICE_TOKEN=local-only-optional-token

# Frontend
VITE_PUBLIC_EVALUATIONS_ENABLED=true
VITE_WORKSPACE_AUTH_REQUIRED=true
VITE_GOOGLE_CLIENT_ID=replace-with-internal-web-client.apps.googleusercontent.com
# VITE_API_BASE=http://127.0.0.1:8080

# Internal Python runtime
JUDGE_RUNTIME_MODE=fixture
# Production mode requires every provider, model, and bundle pin below:
# ANTHROPIC_API_KEY=...
# PRD_JUDGE_MODEL=<validated-model-id>
# PRD_JUDGE_ALLOWED_MODELS=<same-validated-model-id>
# PRD_JUDGE_MODEL_TIMEOUT_SECONDS=120
# PRD_JUDGE_EXPECTED_SOURCE_COMMIT=<reviewed-canonical-commit>
# PRD_JUDGE_EXPECTED_MANIFEST_SHA256=<reviewed-runtime-manifest>
# PRD Score is a separate draft-strength diagnostic and is mandatory for an
# EvalGPT deployment. Keep the entire deployment closed until its exact
# model/runtime pair passes the family-separated release gate.
# PRD_SCORE_ENABLED=true
# PRD_SCORE_TIMEOUT_SECONDS=120
# PRD_SCORE_MODEL=<validated-score-model-id>
# PRD_SCORE_ALLOWED_MODELS=<same-validated-score-model-id>
# PRD_SCORE_EXPECTED_SOURCE_COMMIT=<reviewed-canonical-score-commit>
# PRD_SCORE_EXPECTED_MANIFEST_SHA256=<reviewed-score-runtime-manifest>
