# API gateway
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
DAILY_RUN_LIMIT=100
EVALUATIONS_ENABLED=true
EVALUATION_TIMEOUT_MS=150000
PRD_JUDGE_RUNTIME_URL=http://127.0.0.1:8092
USE_GOOGLE_IDENTITY_TOKEN=false
# INTERNAL_SERVICE_TOKEN=local-only-optional-token

# Internal Python runtime
JUDGE_RUNTIME_MODE=fixture
# Production mode requires every provider, model, and bundle pin below:
# ANTHROPIC_API_KEY=...
# PRD_JUDGE_MODEL=<validated-model-id>
# PRD_JUDGE_ALLOWED_MODELS=<same-validated-model-id>
# PRD_JUDGE_MODEL_TIMEOUT_SECONDS=120
# PRD_JUDGE_EXPECTED_SOURCE_COMMIT=<reviewed-canonical-commit>
# PRD_JUDGE_EXPECTED_MANIFEST_SHA256=<reviewed-runtime-manifest>
