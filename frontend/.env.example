# Fail closed by default. Public deployments must keep document evaluation
# disabled until the exact runtime/model/privacy certification gates pass.
VITE_PUBLIC_EVALUATIONS_ENABLED=false
VITE_WORKSPACE_AUTH_REQUIRED=true
VITE_GOOGLE_CLIENT_ID=replace-with-internal-web-client.apps.googleusercontent.com

# Internal previews may set live evaluation to true and bind to the exact
# zero-traffic gateway revision under review.
# VITE_PUBLIC_EVALUATIONS_ENABLED=true
# VITE_API_BASE=https://GATEWAY-REVISION-URL
