# Fail closed by default. Public deployments must keep document evaluation
# disabled until the exact runtime/model/privacy certification gates pass.
VITE_PUBLIC_EVALUATIONS_ENABLED=false

# Internal certification previews may set the flag to true and bind to the
# exact zero-traffic API version under review.
# VITE_PUBLIC_EVALUATIONS_ENABLED=true
# VITE_API_BASE=https://VERSION-dot-api-dot-PROJECT_ID.REGION_ID.r.appspot.com
